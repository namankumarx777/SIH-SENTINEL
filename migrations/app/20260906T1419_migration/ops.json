        "sql": "CREATE TABLE \"public\".\"invitation\" (\n  \"acceptedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" uuid NOT NULL,\n  \"email\" text NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"organizationId\" uuid NOT NULL,\n  \"role\" text NOT NULL,\n  \"token\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"invitation_role_check_57dbd473\" CHECK (\"role\" IN ('ADMIN', 'INVESTIGATOR', 'REVIEWER', 'FORENSIC', 'AUDITOR'))\n)",
